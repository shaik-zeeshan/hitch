{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "Cargo.toml",
    "Cargo.lock",
    "crates/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "tauri": {
      "cache": false,
      "persistent": true
    }
  }
}
